# Streamlit Community Cloud Secrets Configuration
# Rename or copy this file to .streamlit/secrets.toml or paste these keys into Streamlit Cloud -> Settings -> Secrets

# ---- LLM provider ----
LLM_PROVIDER = "groq"
GROQ_API_KEY = "your_groq_api_key_here"
GROQ_MODEL = "llama-3.3-70b-versatile"

# ---- Threat-intel API keys (all free tier) ----
VIRUSTOTAL_API_KEY = "your_virustotal_api_key_here"
ABUSEIPDB_API_KEY = "your_abuseipdb_api_key_here"
OTX_API_KEY = "your_alienvault_otx_api_key_here"
NVD_API_KEY = "your_nvd_api_key_here"
SHODAN_API_KEY = "your_shodan_api_key_here"

# ---- Behaviour ----
DEMO_MODE = "false"
