# ---- LLM provider ----
# LLM_PROVIDER: "groq" (default, free tier) or "ollama" (Ollama Cloud, free)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Cloud (only if LLM_PROVIDER=ollama). Get a free key at https://ollama.com
# OLLAMA_API_KEY=your_ollama_cloud_key
# OLLAMA_HOST=https://ollama.com
# OLLAMA_MODEL=gpt-oss:120b

# ---- Threat-intel API keys (all free tier) ----
VIRUSTOTAL_API_KEY=your_vt_key
ABUSEIPDB_API_KEY=your_abuseipdb_key
OTX_API_KEY=your_otx_key
NVD_API_KEY=your_nvd_key
SHODAN_API_KEY=your_shodan_key

# ---- Behaviour ----
# DEMO_MODE=true serves recorded fixtures instead of live APIs (offline demo / no keys).
DEMO_MODE=false

# ---- Optional: LangSmith tracing ----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key
# LANGCHAIN_PROJECT=threat-intel-agent
